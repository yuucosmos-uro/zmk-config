#include <dt-bindings/zmk/matrix_transform.h>
#include "poco-layouts.dtsi"

&xiao_i2c { status = "disabled"; };
&xiao_serial { status = "disabled"; };

&physical_layout0 {
  transform = <&default_transform>;
};

/ {
  chosen {
    zmk,physical-layout = &physical_layout0;
    zmk,battery = &vbatt;
  };

  default_transform: keymap_transform_0 {
    compatible = "zmk,matrix-transform";
    columns = <10>;
    rows = <4>;
    map = <
                RC(0,1) RC(0,2) RC(0,3) RC(0,4)                    RC(0,5) RC(0,6) RC(0,7) RC(0,8)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0)         RC(3,2) RC(3,3) RC(3,4)                    RC(3,5) RC(3,6) RC(3,7)          RC(3,9)
    >;
  };

  kscan0: kscan0 {
    compatible= "zmk,kscan-gpio-matrix";
    diode-direction = "col2row";
    wakeup-source;

    row-gpios
        = <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>;
  };

  vbatt: vbatt {
    compatible = "zmk,battery-voltage-divider";
    status = "okay";
    io-channels = <&adc 0>;
    output-ohms = <470000>;
    full-ohms = <(1000000 + 470000)>;
    // mv-to-pct-thresholds = <1000 1100 1170 1220 1260 1300 1340 1380 1420 1460 1520>;
  };
};
